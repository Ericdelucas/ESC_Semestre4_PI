# Copie para Backend/.env e preencha. Não versionar o .env.
GOOGLE_API_KEY=
# Deploy: a Render injeta PORT. Localmente a API usa 8000 se PORT/API_PORT nao existirem.
PORT=
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=
# Origens adicionais separadas por virgula, sem barra final.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
# PostgreSQL/Supabase. Na Render o host db.* e so-IPv6 — use o pooler (IPv4, porta 6543).
# Dashboard Supabase → Connect → Session pooler:
# postgresql://postgres.<ref>:senha@aws-0-<regiao>.pooler.supabase.co:6543/postgres
DATABASE_URL=
DATABASE_URL_POOLER=
SUPABASE_POOLER_URL=
SUPABASE_REGION=

# SMTP (Gmail: use senha de aplicativo, nao a senha da conta)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# 465 = SSL direto; 587 = STARTTLS. Opcional: SMTP_MODE=ssl|starttls
SMTP_MODE=
SMTP_TIMEOUT=20
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
EMAIL_ALERTA_CEO=ericdelucass@gmail.com
RISK_RUIN_THRESHOLD=15
RISK_LIQUIDEZ_MIN=1.0
# True dispara o e-mail de alerta no login mesmo com ruina baixa (validacao)
FORCE_EMAIL_ALERT_ON_LOGIN=True
ALERT_DEBOUNCE_LOGIN_SECONDS=900
ALERT_DEBOUNCE_MANUAL_SECONDS=45
